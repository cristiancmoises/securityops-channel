;;; Executable test script: not a Guix channel module.
;;; Evaluate every supported export without building outputs.
(use-modules (securityops build-farm ci)
             (guix packages)
             (guix store)
             (srfi srfi-1)
             (ice-9 format))

(let* ((rows (channel-package-rows))
       (supported
        (filter (lambda (row)
                  (member "x86_64-linux"
                          (package-supported-systems (list-ref row 4))))
                rows))
       (expected
        (sort (map (lambda (row)
                     (string-append (car row) "." (cadr row) ".x86_64-linux"))
                   supported)
              string<?)))
  (with-store store
    (let ((jobs (cuirass-jobs store '((systems . ("x86_64-linux"))))))
      (format #t "derivation_jobs=~a exported_packages=~a unsupported=~a~%"
              (length jobs) (length rows) (- (length rows) (length supported)))
      (unless (equal? (sort (map (lambda (job) (assoc-ref job #:job-name)) jobs)
                           string<?)
                      expected)
        (error "supported exports do not match derivation jobs")))))
