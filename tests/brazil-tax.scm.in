;;; Run with: guix repl -L . tests/brazil-tax.scm.in

(use-modules (guix packages) (srfi srfi-64))

(test-begin "brazil-tax-exports")
(define runner (test-runner-current))
(define interface
  (catch #t
    (lambda () (resolve-interface '(securityops packages brazil-tax)))
    (lambda _ #f)))
(for-each
 (lambda (name)
   (test-assert (symbol->string name)
     (and interface
          (module-defined? interface name)
          (package? (module-ref interface name))
          ;; These are inert data, not applications or activated services.
          (null? (package-inputs (module-ref interface name)))
          (null? (package-propagated-inputs (module-ref interface name))))))
 '(esocial-schemas esocial-communication-schemas))
(test-end "brazil-tax-exports")
(exit (if (zero? (test-runner-fail-count runner)) 0 1))
