;; Run with guix repl -L . tests/reporting.scm.in.
(use-modules (guix packages)
             (securityops packages reporting))

(unless (and (package? arelle)
             (string=? (package-name arelle) "arelle")
             (string=? (package-version arelle) "2.46.0"))
  (error "Missing or incorrect Arelle package"))

(for-each
 (lambda (entry)
   (let ((dependency (module-ref (resolve-module '(securityops packages reporting))
                                 (car entry))))
     (unless (string=? (package-version dependency) (cdr entry))
       (error "Incorrect private reporting dependency" (car entry)
              (package-version dependency)))))
 '((python-vcs-versioning-for-arelle . "2.6.0")
   (python-hatchling-for-arelle . "1.32.4")
   (python-filelock-for-arelle . "4.0.12")
   (python-lxml-for-arelle . "6.1.3")))

(for-each (lambda (input)
            (unless (or (package? (cadr input))
                        (origin? (cadr input)))
              (error "Invalid reporting input" input)))
          (append (package-native-inputs arelle)
                  (package-propagated-inputs arelle)))

(unless (equal? '(arelle)
                (module-map (lambda (symbol variable) symbol)
                            (resolve-interface
                             '(securityops packages reporting))))
  (error "Reporting exports private dependencies"))

(unless (null? (module-map (lambda (symbol variable) symbol)
                          (resolve-interface
                           '(securityops packages xml-security))))
  (error "Native security dependencies are publicly exported"))
