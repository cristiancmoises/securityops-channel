;; Run with guix repl -L . tests/reporting.scm.in.
(use-modules (guix packages)
             (srfi srfi-1)
             (securityops packages reporting))

(define (private-input package name)
  (any (lambda (input)
         (and (pair? input)
              (string=? (car input) name)
              (cadr input)))
       (append (package-native-inputs package)
               (package-propagated-inputs package))))

(unless (and (package? arelle)
             (string=? (package-name arelle) "arelle")
             (string=? (package-version arelle) "2.47.4"))
  (error "Missing or incorrect Arelle package"))

(for-each
 (lambda (entry)
   (let ((dependency (module-ref (resolve-module '(securityops packages reporting))
                                 (car entry))))
     (unless (string=? (package-version dependency) (cdr entry))
       (error "Incorrect private reporting dependency" (car entry)
              (package-version dependency)))))
 '((python-vcs-versioning-for-arelle . "2.6.0")
   (python-hatchling-for-arelle . "1.33.0")
   (python-hatch-fancy-pypi-readme-for-arelle . "25.1.0")
   (python-packaging-for-arelle . "26.3")
   (python-installer-for-arelle . "1.1.0")
   (python-zipremove-for-arelle . "0.10.0")
   (python-sbom-for-arelle . "0.3.1")
   (python-filelock-for-arelle . "4.2.10")
   (python-lxml-for-arelle . "6.1.3")))

(let* ((sbom (module-ref (resolve-module '(securityops packages reporting))
                         'python-sbom-for-arelle))
       (hatch-vcs (private-input sbom "python-hatch-vcs"))
       (setuptools-scm (and hatch-vcs
                            (private-input hatch-vcs "python-setuptools-scm")))
       (required-tests
        '(("python-flit-core" . "3.12.0")
          ("python-pdm-backend" . "2.4.5")
          ("python-license-expression" . "30.1.0")
          ("python-pytest-mock" . "3.17.0")
          ("python-jsonschema-rs" . "0.61.2")
          ("python-spdx-tools" . "0.8.5"))))
  (for-each
   (lambda (entry)
     (let ((dependency (private-input sbom (car entry))))
       (unless dependency
         (error "Missing python-sbom test dependency" (car entry)))
       (unless (string=? (package-version dependency) (cdr entry))
         (error "Incorrect python-sbom test dependency" (car entry)
                (package-version dependency)))))
   required-tests)
  (unless hatch-vcs
    (error "Missing python-sbom VCS versioning dependency"))
  (unless (string=? (package-version hatch-vcs) "0.5.0")
    (error "Incorrect python-sbom VCS versioning dependency"
           (package-version hatch-vcs)))
  (unless setuptools-scm
    (error "Missing python-sbom setuptools-scm dependency"))
  (unless (string=? (package-version setuptools-scm) "9.2.2")
    (error "Incorrect python-sbom setuptools-scm dependency"
           (package-version setuptools-scm))))

(for-each (lambda (input)
            (unless (or (package? (cadr input))
                        (origin? (cadr input)))
              (error "Invalid reporting input" input)))
          (append (package-native-inputs arelle)
                  (package-propagated-inputs arelle)))

(unless (equal? '(arelle)
                (module-map (lambda (symbol variable) symbol)
                            (resolve-interface
                             '(securityops packages reporting))))
  (error "Reporting exports private dependencies"))

(unless (null? (module-map (lambda (symbol variable) symbol)
                          (resolve-interface
                           '(securityops packages xml-security))))
  (error "Native security dependencies are publicly exported"))
