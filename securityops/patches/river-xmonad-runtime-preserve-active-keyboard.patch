+
+// Preserve seat metadata when reconfiguration destroys its active group.
+// A shared group remains active for its other keyboards, and changing an
+// inactive group must not select it until it receives input.
+fn updateGroup(keyboard: *Keyboard) void {
+    const seat = keyboard.device.seat.wlr_seat;
+    const replace_active = if (keyboard.group) |group|
+        group.ref_count == 1 and seat.getKeyboard() == &group.state
+    else
+        false;
+
     if (keyboard.group) |group| {
         group.unref(keyboard.pressed.keys());
         keyboard.group = null;
     }
     keyboard.setGroup();
+    if (replace_active) {
+        if (keyboard.group) |group| seat.setKeyboard(&group.state);
+    }
 }
 
