         return NULL;
 
+    alignedsize = FFALIGN(size, alignment);
+
     if (alignedsize != s->pool_size[plane]) {
         av_buffer_pool_uninit(&s->pools[plane]);
         s->pools[plane] = av_buffer_pool_init(alignedsize, NULL);
