The prompt text is printed before tcsetattr disables echo.  Waiting for the
text alone races with the transition on headless builders; keep both the echo
off assertion and the SIGINT restoration assertion.

--- a/tests/test_password_prompt_signal.sh
+++ b/tests/test_password_prompt_signal.sh
@@ -62,8 +62,16 @@
         if b"Password:" not in transcript:
             raise SystemExit("password prompt was not reached")
-        hidden = termios.tcgetattr(slave)
+        # The prompt is emitted before the program disables terminal echo.
+        echo_deadline = time.monotonic() + 2
+        while True:
+            hidden = termios.tcgetattr(slave)
+            if not (hidden[3] & termios.ECHO) or time.monotonic() >= echo_deadline:
+                break
+            if process.poll() is not None:
+                break
+            time.sleep(0.01)
         if hidden[3] & termios.ECHO:
             raise SystemExit("terminal echo was not disabled during prompt")
 
         process.send_signal(signal.SIGINT)
         process.wait(timeout=10)
