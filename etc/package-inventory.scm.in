;; Run with guix repl -L . etc/package-inventory.scm.in.
(use-modules (guix discovery) (guix packages) (ice-9 format))
(fold-module-public-variables*
 (lambda (module symbol binding result)
   (let ((package (variable-ref binding))
         (name (module-name module)))
     (when (package? package)
       (format #t "~a\t~a\t~a\t~a\n"
               (if (eq? (car name) 'securityops)
                   (caddr name)
                   'xlibre-drivers)
               symbol (package-version package)
               (package-home-page package))))
   result)
 #f
 (map resolve-interface
  (append
   (map (lambda (name) `(securityops packages ,name))
       ;; Project owners precede compatibility reexports such as containers.
       '(btp esquema evelin guixvis mirim moneyprinterturbo torando-gui turborec
         whatsappel zupt
         arduino audio ausweisapp autofirma belgian-eid brazil-tax browsers chromium containers digidoc4 eid
         einvoicing electronics emacs games icp-brasil icp-brasil-chain librewolf monitoring nvidia openpace
         phive remote-desktop reporting river security zabbix
         shells terminals tor utils video vpn wazuh wazuh-search webpki xlibre xmonad
         xmonad-wayland xsearch))
   '((xlibre)))))
