;; Run with guix repl -L . etc/package-inventory.scm.in.
(use-modules (guix packages) (ice-9 format))
(for-each
 (lambda (name)
   (let ((interface (resolve-interface `(securityops packages ,name))))
     (module-for-each
      (lambda (symbol binding)
        (let ((package (variable-ref binding)))
          (when (package? package)
            (format #t "~a\t~a\t~a\t~a\n"
                    name symbol (package-version package)
                    (package-home-page package)))))
      interface)))
 '(apps audio browsers chromium containers emacs games librewolf monitoring
   river security shells terminals tor utils video vpn xlibre))
