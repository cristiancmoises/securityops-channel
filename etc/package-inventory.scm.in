;; Run with guix repl -L . etc/package-inventory.scm.in.
(use-modules (guix packages) (ice-9 format))
(for-each
 (lambda (name)
   (let ((interface (resolve-interface name)))
     (module-for-each
      (lambda (symbol binding)
        (let ((package (variable-ref binding)))
          (when (package? package)
            (format #t "~a\t~a\t~a\t~a\n"
                    (if (eq? (car name) 'securityops)
                        (caddr name)
                        'xlibre-drivers)
                    symbol (package-version package)
                    (package-home-page package)))))
      interface)))
 (append
  (map (lambda (name) `(securityops packages ,name))
       '(apps audio autofirma brazil-tax browsers chromium containers eid
         einvoicing emacs games librewolf monitoring nvidia river security
         shells terminals tor utils video vpn webpki xlibre xmonad
         xmonad-wayland xsearch))
  '((xlibre))))
