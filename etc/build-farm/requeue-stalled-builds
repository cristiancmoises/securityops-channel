#!/bin/sh
# Re-submit pending Cuirass builds that no evaluation will ever dispatch.
#
# Cuirass 1.3.6 only sends scheduled derivations to its local builder at
# register startup ("restart-builds") or when a new evaluation registers
# builds.  After an evaluation completes, the prioritize job flips failed
# dependencies back to "scheduled", but nothing dispatches them until the
# register process restarts.  Detect that stall and restart the register
# service, bounded to once per 30 minutes.
set -eu

RUNUSER=${RUNUSER:-/usr/sbin/runuser}
PSQL=${PSQL:-/usr/bin/psql}
SYSTEMCTL=${SYSTEMCTL:-/usr/bin/systemctl}
REGISTER=securityops-cuirass-register.service
MARKER=${MARKER:-/var/lib/cuirass/.requeue-last}
MIN_INTERVAL=${MIN_INTERVAL:-1800}

query() {
    "$RUNUSER" -u postgres -- "$PSQL" -X -A -t -d cuirass -c "$1"
}

if [ -e /etc/cuirass/maintenance ]; then
    echo "maintenance flag set; skipping requeue check"
    exit 0
fi

pending=$(query "SELECT count(*) FROM builds WHERE status = -2;")
started=$(query "SELECT count(*) FROM builds WHERE status = -1;")

case "$pending" in ''|*[!0-9]*) echo "invalid pending count: $pending" >&2; exit 1;; esac
case "$started" in ''|*[!0-9]*) echo "invalid started count: $started" >&2; exit 1;; esac

echo "pending(scheduled)=$pending started=$started"
if [ "$pending" -le 0 ] || [ "$started" -gt 0 ]; then
    echo "no stall detected; no restart"
    exit 0
fi

now=$(date +%s)
last=0
[ -f "$MARKER" ] && last=$(cat "$MARKER" 2>/dev/null || echo 0)
case "$last" in ''|*[!0-9]*) last=0;; esac

if [ $((now - last)) -lt "$MIN_INTERVAL" ]; then
    echo "restart debounced (last at $last); skipping"
    exit 0
fi

echo "$now" > "$MARKER"
echo "stalled build queue detected; restarting $REGISTER"
"$SYSTEMCTL" restart "$REGISTER"
