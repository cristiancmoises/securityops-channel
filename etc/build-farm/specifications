;; Keep the Guix base stable while SecurityOps polls for channel changes.
;; A moving Guix head can change every target store path before its builds
;; finish; advance this commit only after reviewing the previous evaluation.
(define guix-baseline
  (channel
   (inherit %default-guix-channel)
   (commit "99c84619b4b7aae9f250c65c89b31c817789e44d")))

