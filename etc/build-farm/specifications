;; This executable script is extensionless so Guix does not compile it as a module.
;; Only authenticated channel heads are evaluated.  The private builder keeps
;; all outputs; publication to CT116 is a separate reviewed operation.
(use-modules (cuirass specification)
             (guix channels)
             (guix openpgp))

(define (signed-channel name url branch introduction signer)
  (channel
   (name name)
   (url url)
   (branch branch)
   (introduction
    (make-channel-introduction
     introduction
     (openpgp-fingerprint signer)))))

